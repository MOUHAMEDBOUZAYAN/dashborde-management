# NestJS API origin (no trailing slash). Used by src/lib/api.ts via src/config/constants.ts.
NEXT_PUBLIC_API_BASE_URL=https://api.63agency.com

# DEV ONLY — when "true", dashboard skips login (AUTH_BYPASS) and uses BYPASS_MOCK_CLIENT.
# Set to "false" for real auth against the API. Never enable in production.
NEXT_PUBLIC_AUTH_BYPASS=false
